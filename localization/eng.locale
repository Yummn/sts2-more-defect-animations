{
  "Title": "More Defect Animations",
  "Enabled": "Enable animations",
  "CoolheadedEnabled": "Coolheaded animation",
  "Description": "Adds nineteen Defect card animations in solo and multiplayer without changing card resolution.",
  "EnabledDescription": "Enable local visual effects in solo and multiplayer. Turning this off removes active effects immediately.",
  "CoolheadedEnabledDescription": "Show head-following ice with original snow and mist. Ice holds for 2 seconds; repeated plays refresh the duration smoothly.",
  "ChargeBatteryEnabled": "Charge Battery animation",
  "ChargeBatteryEnabledDescription": "Show clamps, elastic leads, dynamic cables and both original electrical arcs. Cables fade in, hold for 2 seconds, then fade out. Arcs keep their original opacity.",
  "BiasedCognitionEnabled": "Biased Cognition animation",
  "BiasedCognitionEnabledDescription": "Scan for 1 second, then keep the holographic symbols until combat ends. Recasts rescan without duplicating symbols.",
  "HotfixEnabled": "Hotfix animation",
  "HotfixEnabledDescription": "Show eye circuits, scrolling eye patterns and three hanging cables when playing Hotfix.",
  "SignalBoostEnabled": "Signal Boost animation",
  "SignalBoostEnabledDescription": "Keep the dish while Signal Boost has stacks. Amount changes queue signal waves; the final wave finishes before the dish retracts.",
  "BufferEnabled": "Buffer animation",
  "BufferEnabledDescription": "Keep one sign behind the character while Buffer has stacks. Actual consumption hits the sign; the final layer shatters it.",
  "SupercriticalEnabled": "Supercritical animation",
  "SupercriticalEnabledDescription": "Independent flowing energy ribbons for every actual play; earlier effects finish their full lifetime.",
  "DefragmentEnabled": "Defragment animation",
  "DefragmentEnabledDescription": "Each actual play adds an independent 1.8-second wall and blue insert behind the character, in front of Buffer. Consecutive plays overlap.",
  "ModdedEnabled": "Modded animation",
  "ModdedEnabledDescription": "The mask remains for the current turn and independently retracts at turn end. Cables follow the character; native card effects are unchanged.",
  "FlakCannonEnabled": "Flak Cannon animation",
  "FlakCannonEnabledDescription": "Deploy when Flak Cannon enters the hand. Retract when no copies remain, after any active attack finishes. Attacks interrupt deployment and retraction.",
  "BulkUpEnabled": "Bulk Up animation",
  "BulkUpEnabledDescription": "Each play independently emits three waves of 3D ribbons and seven eye flashes; the effect finishes through character action changes.",
  "HologramEnabled": "Hologram animation",
  "HologramEnabledDescription": "Projects the character body with a 0.12-second pose delay for a three-second cycle. Replaying starts a fresh cycle. Accessories are excluded.",
  "IceLanceEnabled": "Ice Lance animation",
  "IceLanceEnabledDescription": "Fires a faceted ice lance at the actual target, with swirling frost and a 0.18-second hold after the native hit.",
  "DualcastEnabled": "Dualcast orb effects",
  "QuadcastEnabled": "Quadcast / Multi-Cast orb effects",
  "ConsumingShadowEnabled": "Consuming Shadow animation",
  "DualcastEnabledDescription": "Enhance actual evokes of Dark, Lightning, Frost, Plasma and Glass orbs. Original targets and effects remain unchanged.",
  "QuadcastEnabledDescription": "Quadcast and Multi-Cast share enhanced effects for each actual orb and evoke. Preserves original targets, X costs and resolution.",
  "ConsumingShadowEnabledDescription": "Blue and purple flames circle the body and disperse to actual receiving slots. Decorative tails finish within one second; native channeling keeps its own timing.",
  "GunkUpEnabled": "Gunk Up",
  "GunkUpEnabledDescription": "A dirty translucent slime jet for each native hit.",
  "CompileDriverEnabled": "Compile Driver",
  "CompileDriverEnabledDescription": "Short beam, rotating rings and body-anchored binary wave."
}
